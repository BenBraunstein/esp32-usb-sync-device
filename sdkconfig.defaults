# TinyUSB Mass Storage Class
CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_TINYUSB_MSC_BUFSIZE=4096

# Main task stack (needs room for WiFi + init)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# FAT long filename support (required for .pes filenames)
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_API_ENCODING_UTF_8=y
CONFIG_FATFS_MAX_LFN=255

# Custom partition table (larger app partition for WiFi+MQTT+USB binary)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# FAT sector size — MUST be 512 for SD cards (default 4096 causes silent write failures)
CONFIG_FATFS_SECTOR_512=y
# CONFIG_FATFS_SECTOR_4096 is not set

# LED strip RMT memory
CONFIG_LED_STRIP_RMT_DEFAULT_MEM_BLOCK_SYMBOLS=48
